    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Power uses the camera to scan food barcodes and nutrition tables, and to estimate foods from a photo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power verwendet die Kamera, um Barcodes und Nährwerttabellen von Lebensmitteln zu scannen und Mahlzeiten anhand eines Fotos zu schätzen."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Power liest dein Körpergewicht aus der Health-App, damit es bei deinen Körpermaßen angezeigt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Power reads your bodyweight from Health so it appears in your body measurements."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Power sichert deine abgeschlossenen Trainings und das von dir erfasste Körpergewicht in der Health-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Power saves your finished workouts and the bodyweight you log to Health."
          }
        }
