          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Design"
          }
        }
      }
    },
    "These weights are much heavier than your usual sets, like a missing decimal point. Turned on means the corrected weight is imported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
