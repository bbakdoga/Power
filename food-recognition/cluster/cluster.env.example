# Copy to cluster/cluster.env (gitignored) on your Mac and fill in.
# No passwords here: log in with an SSH key or your cluster's normal sign-in.

# Host alias from ~/.ssh/config (e.g. "Host pegasus")
CLUSTER_HOST=pegasus
# Where the project lives on the cluster (your scratch or project space)
CLUSTER_WORKDIR=/path/on/cluster/food-recognition
# Scheduler: slurm or lsf
CLUSTER_SCHEDULER=slurm
# Account / project / queue names from your cluster's documentation
CLUSTER_ACCOUNT=your_account
CLUSTER_PARTITION=gpu
CLUSTER_QOS=
# Module or conda setup run at the start of each job
CLUSTER_ENV_SETUP="module load python/3.11 cuda/12.4 && source $CLUSTER_WORKDIR/.venv/bin/activate"
